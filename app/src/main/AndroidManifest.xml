<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Internet & Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ image access -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="SelectedPhotoAccess" />
    <!-- Android 14+ selected photo access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notifications Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional Camera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <!-- Main Launcher -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true" />

        <activity
            android:name=".activities.SignupActivity"
            android:exported="true" />

        <activity
            android:name=".activities.AdminLogin"
            android:exported="false" />

        <activity
            android:name=".activities.AdminSignUp"
            android:exported="false" />

        <activity
            android:name=".activities.AdminShopSignupActivity"
            android:exported="false" />

        <!-- User Activities -->
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserDashboard"
            android:exported="false" />

        <activity
            android:name=".activities.UserProfile"
            android:exported="false" />

        <activity
            android:name=".activities.EditUserProfile"
            android:exported="false" />

        <activity
            android:name=".activities.UserAddressActivity"
            android:exported="false" />

        <activity
            android:name=".activities.CartDetailsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".activities.OrderPlaced"
            android:exported="false" />

        <activity
            android:name=".activities.OrderStatusActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserOrderHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserOrderDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserViewFeedbacksActivity"
            android:exported="false" />

        <!-- Admin Activities -->
        <activity
            android:name=".activities.AdminDashboard"
            android:exported="false" />

        <activity
            android:name=".activities.AdminProfile"
            android:exported="false" />

        <activity
            android:name=".activities.EditAdminProfile"
            android:exported="false" />

        <activity
            android:name=".activities.AdminOrderManagement"
            android:exported="false" />

        <activity
            android:name=".activities.AdminOrderDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminStockManageActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminViewFeedbacksActivity"
            android:exported="false" />

        <!-- Shop -->
        <activity
            android:name=".activities.ShopDetails"
            android:exported="false" />

        <activity
            android:name=".activities.ShopStockActivity"
            android:exported="false" />

        <activity
            android:name=".ShopStockManage"
            android:exported="false" />

        <!-- Utility -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".activities.OtpVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ResetPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PrivacyPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".activities.TermsOfServiceActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SavedItemsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AiAssistantActivity"
            android:exported="false" />

        <!-- Firebase Messaging -->
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

    </application>

</manifest>