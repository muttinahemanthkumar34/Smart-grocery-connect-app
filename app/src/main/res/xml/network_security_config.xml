<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for GroceryConnect
    Allows cleartext (HTTP) traffic for development.
    For production, use HTTPS and remove cleartextTrafficPermitted.
-->
<network-security-config>
    <!-- Allow cleartext traffic for all domains (development only) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Specific domain config for the API server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.135.251.20</domain>
        <domain includeSubdomains="true">10.179.4.20</domain>
        <domain includeSubdomains="true">192.168.1.8</domain>
        <domain includeSubdomains="true">10.228.208.20</domain>
        <domain includeSubdomains="true">10.127.7.36</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
