<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A120B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Shop Details"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Shop Image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/iv_shop_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar_circle"
                    android:src="@drawable/ic_shop_placeholder"/>

                <ImageView
                    android:id="@+id/iv_camera_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_button_orange"
                    android:padding="6dp"
                    android:src="@drawable/ic_camera"
                    app:tint="#FFFFFF"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to change shop image"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Shop Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Name"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_shop_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Enter shop name"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- Shop Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Address"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_shop_address"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Enter shop address"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="12dp"/>

        <!-- City and Pincode Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_city"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="City"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pincode"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_pincode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Pincode"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="number"
                    android:maxLength="6"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Shop Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Phone"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_shop_phone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Enter shop phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="phone"
            android:layout_marginBottom="12dp"/>

        <!-- Opening and Closing Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opening Time"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_opening_time"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="09:00 AM"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:clickable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Closing Time"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/et_closing_time"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="09:00 PM"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:clickable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Delivery Radius -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Radius (km)"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_delivery_radius"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Enter delivery radius"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <!-- UPI ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPI ID (for payments)"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_upi_id"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_edit_text"
            android:hint="e.g., yourshop@paytm"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="24dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel"
                android:textColor="#AAAAAA"
                android:textAllCaps="false"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Save Changes"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#FF9800"/>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
