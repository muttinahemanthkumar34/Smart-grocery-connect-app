<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1C1C1C"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Shop Image -->
        <ImageView
            android:id="@+id/iv_shop_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_circle"
            android:src="@drawable/ic_shop_placeholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Shop Name -->
        <TextView
            android:id="@+id/tv_shop_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="FreshMart"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_shop_image"
            app:layout_constraintEnd_toStartOf="@id/tv_status_badge"/>

        <!-- Status Badge (Open/Closed) -->
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_open"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Distance -->
        <TextView
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 0.8 miles"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_shop_name"
            app:layout_constraintStart_toEndOf="@id/iv_shop_image"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"/>

        <!-- Delivery Status -->
        <TextView
            android:id="@+id/tv_delivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚚 Delivery Available"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_distance"
            app:layout_constraintStart_toEndOf="@id/iv_shop_image"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"/>

        <!-- Rating -->
        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 4.7"
            android:textColor="#FFD700"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_distance"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
