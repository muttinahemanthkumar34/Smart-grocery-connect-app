<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1F0A"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Status"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iv_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_ready_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ready in 10 min"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tv_estimated_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Estimated Pickup: 3:45 PM"
        android:textColor="#A5CFA0"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_ready_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Timeline -->
    <LinearLayout
        android:id="@+id/layout_timeline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_estimated_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <!-- Step 1: Order Accepted -->
        <LinearLayout
            android:id="@+id/layout_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_step1_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check"
                android:background="@drawable/bg_gray_circle"
                android:padding="6dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_step1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Accepted"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_step1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#A5CFA0"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/line1"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#2A2A2A"
            android:layout_marginStart="13dp"/>

        <!-- Step 2: Preparing Your Order -->
        <LinearLayout
            android:id="@+id/layout_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_step2_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check"
                android:background="@drawable/bg_gray_circle"
                android:padding="6dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_step2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preparing Your Order"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_step2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#A5CFA0"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/line2"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#2A2A2A"
            android:layout_marginStart="13dp"/>

        <!-- Step 3: Ready for Pickup / Out for Delivery -->
        <LinearLayout
            android:id="@+id/layout_step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_step3_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bag"
                android:background="@drawable/bg_gray_circle"
                android:padding="6dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_step3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready for Pickup"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_step3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#A5CFA0"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/line3"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#2A2A2A"
            android:layout_marginStart="13dp"/>

        <!-- Step 4: Order Completed -->
        <LinearLayout
            android:id="@+id/layout_step4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_step4_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_flag"
                android:background="@drawable/bg_gray_circle"
                android:padding="6dp"/>

            <TextView
                android:id="@+id/tv_step4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Completed"
                android:textColor="#777777"
                android:textSize="14sp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Order Summary -->
    <LinearLayout
        android:id="@+id/layout_order_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1F3A1A"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@id/btn_back_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_order_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#GRC-0000"
                android:textColor="#A5CFA0"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="#FFFFFF"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_back_home"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Back to Home"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        android:backgroundTint="#10B981"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
