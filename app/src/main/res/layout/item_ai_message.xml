<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- User Message (Right aligned) -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_user_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:padding="12dp"
            android:background="@drawable/bg_chip_selected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- AI Message (Left aligned) -->
    <LinearLayout
        android:id="@+id/layout_ai_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_ai_sparkle"
            android:background="@drawable/bg_cart_circle"
            android:padding="6dp"
            app:tint="#000000"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <!-- Simple Text Response -->
            <TextView
                android:id="@+id/tv_ai_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/bg_dialog_dark"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <!-- Ingredients Card (shown first) -->
            <LinearLayout
                android:id="@+id/layout_ingredients_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_dark"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <!-- Recipe Name -->
                <TextView
                    android:id="@+id/tv_recipe_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#10B981"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Category -->
                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"/>

                <!-- Ingredients Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📦 Ingredients"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>

                <!-- Get Recipe Button -->
                <Button
                    android:id="@+id/btn_get_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="👨‍🍳 Get Recipe Steps"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#10B981"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- Recipe Steps Card (shown when Get Recipe is clicked) -->
            <LinearLayout
                android:id="@+id/layout_recipe_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_dark"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <!-- Steps Header with Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👨‍🍳 Recipe Steps"
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_prep_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:textColor="#10B981"
                        android:textSize="11sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- Suggestions Card Container -->
            <LinearLayout
                android:id="@+id/layout_suggestions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_dark"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <!-- Suggestions Header -->
                <TextView
                    android:id="@+id/tv_suggestions_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Food Suggestions"
                    android:textColor="#10B981"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Suggestions Chips Container (FlexboxLayout style) -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layout_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="flex_start"
                    app:justifyContent="flex_start">
                    <!-- Suggestions will be added programmatically -->
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Load More Button (inside the card) -->
                <Button
                    android:id="@+id/btn_load_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="Load More Suggestions"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- Recipe List Container (for multiple matches) -->
            <LinearLayout
                android:id="@+id/layout_recipe_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <!-- Recipe summaries will be added programmatically -->
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
