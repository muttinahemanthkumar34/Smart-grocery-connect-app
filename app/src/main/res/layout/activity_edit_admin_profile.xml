<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A120B"
    android:padding="16dp">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iv_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ScrollView for form -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_save_changes"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Personal Details Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Details"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#241C14"
                android:hint="Enter your name"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="textPersonName"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"/>

            <!-- Phone Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#241C14"
                android:hint="Enter phone number"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="phone"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"/>

            <!-- Shop Details Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shop Details"
                android:textColor="#FF9800"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Shop Name Field (Read-only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/et_shop_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#1A1410"
                android:hint="Shop name"
                android:textColor="#888888"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="none"
                android:enabled="false"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"/>

            <!-- Shop Address Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Address"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/et_shop_address"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#241C14"
                android:hint="Enter shop address"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"/>

            <!-- City Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/et_city"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#241C14"
                android:hint="Enter city"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Save Changes Button -->
    <Button
        android:id="@+id/btn_save_changes"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Save Changes"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:backgroundTint="#FF9800"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
