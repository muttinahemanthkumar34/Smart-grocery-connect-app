<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1A1A1A"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terms of Service"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_document"
            app:tint="#4CAF50"/>
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Last Updated -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Updated: December 29, 2024"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <!-- Acceptance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Acceptance of Terms"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By downloading, installing, or using GroceryConnect, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our application."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Service Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Service Description"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GroceryConnect is a mobile platform that connects users with local grocery stores. We facilitate:\n\n• Browsing products from partner stores\n• Placing orders for delivery or pickup\n• Secure payment processing\n• Order tracking and notifications\n\nWe act as an intermediary between you and the stores. The stores are responsible for product quality, availability, and pricing."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- User Accounts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. User Accounts"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To use GroceryConnect, you must:\n\n• Be at least 18 years old\n• Provide accurate registration information\n• Maintain the security of your account\n• Notify us of any unauthorized access\n• Accept responsibility for all activities under your account"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Orders and Payments -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Orders and Payments"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• All prices are displayed in Indian Rupees (₹)\n• Prices include applicable taxes unless stated otherwise\n• Payment must be made at the time of order\n• Orders can be cancelled before the store begins preparation\n• Refunds for cancelled orders will be processed within 5-7 business days"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Delivery -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Delivery Terms"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Delivery is available within the store's delivery radius\n• Estimated delivery times are approximate\n• You must provide accurate delivery address\n• Someone must be available to receive the order\n• Delivery charges may apply based on distance and order value"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Prohibited Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Prohibited Actions"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You agree not to:\n\n• Use the app for illegal purposes\n• Submit false or misleading information\n• Attempt to hack or disrupt the service\n• Abuse, harass, or threaten store personnel\n• Create multiple accounts for fraudulent purposes"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Limitation of Liability -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. Limitation of Liability"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GroceryConnect is not liable for:\n\n• Product quality issues (contact the store directly)\n• Delays due to unforeseen circumstances\n• Issues arising from incorrect user information\n• Third-party service interruptions\n\nOur maximum liability is limited to the order value."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Termination -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. Account Termination"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We reserve the right to suspend or terminate your account if you violate these terms. You may also delete your account at any time through the app settings."
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- Contact -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9. Contact Information"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For questions about these Terms, contact us:\n\nEmail: legal@groceryconnect.com\nPhone: +91 1234567890"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
