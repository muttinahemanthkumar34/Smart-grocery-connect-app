<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_product_card"
    android:backgroundTint="#241C14"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Order Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Order Icon -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_orders"
            app:tint="#FF9800"
            android:padding="4dp"/>

        <!-- Order Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order #GC-1024"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_customer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹45.50"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_badge_orange"/>
    </LinearLayout>

    <!-- Order Type Badge -->
    <TextView
        android:id="@+id/tv_order_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery"
        android:textColor="#FF9800"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_button_orange_outline"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <!-- Order Details Section -->
    <TextView
        android:id="@+id/tv_details_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Details:"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tv_order_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2x - Organic Bananas\n1x - Almond Milk (1L)\n1x - Sourdough Bread"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="6dp"/>

    <!-- Action Buttons for Pending -->
    <LinearLayout
        android:id="@+id/layout_pending_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Decline"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_outline_orange"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Accept"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#FF9800"/>
    </LinearLayout>

    <!-- Status Update Button for Accepted Orders -->
    <Button
        android:id="@+id/btn_update_status"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Mark as Packing"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

    <!-- View Details Button for Completed -->
    <Button
        android:id="@+id/btn_view_details"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="View Details"
        android:textColor="#FF9800"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_button_orange_outline"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</LinearLayout>
